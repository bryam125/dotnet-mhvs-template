#!/usr/bin/env bash
# Bloquea push directo a main/master como red de seguridad local.
# No reemplaza la protección de rama de GitHub (que requiere plan de
# pago en repos privados) — es una salvaguarda a nivel de máquina,
# saltable a propósito si de verdad hace falta.

protected_branches='refs/heads/main refs/heads/master'

while read -r local_ref local_sha remote_ref remote_sha
do
  for protected in $protected_branches; do
    if [ "$remote_ref" = "$protected" ]; then
      if [ -z "$ALLOW_MAIN_PUSH" ]; then
        echo ""
        echo "🚫 Push bloqueado: estás empujando directo a '${remote_ref#refs/heads/}'."
        echo "   Este repo usa flujo de ramas + PR (ver CONTRIBUTING.md"
        echo "   sección 1)."
        echo ""
        echo "   Crea una rama en su lugar:"
        echo "     git checkout -b tipo/nombre-descriptivo"
        echo ""
        echo "   Si de verdad necesitas saltarte esto (excepcional), usa:"
        echo "     ALLOW_MAIN_PUSH=1 git push"
        echo ""
        exit 1
      fi
    fi
  done
done

exit 0
