{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Diagnostics.ExceptionHandlerMiddleware": "None"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    // Sin orígenes por defecto (ver ARCHITECTURE.md → "CORS"): es la postura intencional del
    // template. Un proyecto real con frontend en otro origen agrega sus URLs aquí, ej.:
    // "AllowedOrigins": [ "https://app.miempresa.com" ]
    "AllowedOrigins": []
  },
  "RateLimiting": {
    "PermitLimit": 100,
    "WindowSeconds": 60
  }
}
