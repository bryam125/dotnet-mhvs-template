<?xml version="1.0" encoding="utf-8"?>
<log4net>
  <!-- %safemessage, nunca %message: escapa \r y \n del mensaje para que un valor de entrada no pueda
       falsificar líneas de log completas (hallazgo 4.4 del ROADMAP). Todo appender nuevo debe
       registrar el converter y usar %safemessage. Ver Bootstrap/Logging/SafeMessagePatternConverter.cs. -->

  <!-- Consola: útil en desarrollo -->
  <appender name="ConsoleAppender" type="log4net.Appender.ConsoleAppender">
    <layout type="log4net.Layout.PatternLayout">
      <converter>
        <name value="safemessage" />
        <type value="MyApp.Bootstrap.Logging.SafeMessagePatternConverter, MyApp.Bootstrap" />
      </converter>
      <conversionPattern value="%date [%thread] %-5level [%property{CorrelationId}] %logger - %safemessage%newline" />
    </layout>
  </appender>

  <!-- Archivo rotado por día: útil en producción -->
  <appender name="RollingFileAppender" type="log4net.Appender.RollingFileAppender">
    <file value="logs/app.log" />
    <appendToFile value="true" />
    <rollingStyle value="Date" />
    <datePattern value="yyyyMMdd" />
    <staticLogFileName value="true" />
    <maxSizeRollBackups value="30" />
    <!-- MinimalLock (adquiere/libera el lock en cada escritura) en vez del ExclusiveLock por
         defecto: permite que más de un proceso/instancia de la app escriba el mismo archivo sin que
         el segundo falle al arrancar con "Unable to acquire lock". No hace falta en un contenedor
         normal (una sola instancia, un solo archivo), pero sí en tests de integración que levantan
         varias instancias de Program en el mismo proceso (ver tests/Bootstrap.IntegrationTests). -->
    <lockingModel type="log4net.Appender.FileAppender+MinimalLock" />
    <layout type="log4net.Layout.PatternLayout">
      <converter>
        <name value="safemessage" />
        <type value="MyApp.Bootstrap.Logging.SafeMessagePatternConverter, MyApp.Bootstrap" />
      </converter>
      <conversionPattern value="%date [%thread] %-5level [%property{CorrelationId}] %logger - %safemessage%newline%exception" />
    </layout>
  </appender>

  <root>
    <level value="INFO" />
    <appender-ref ref="ConsoleAppender" />
    <appender-ref ref="RollingFileAppender" />
  </root>
</log4net>
